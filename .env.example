# Copy this file to `.env` and fill in your own values.
# `.env` is gitignored — never commit real keys.

# RevenueCat API key. Use a Test Store key (test_...) for local development.
# Get one from https://app.revenuecat.com — Project Settings > API keys.
EXPO_PUBLIC_REVENUECAT_TEST_KEY=test_your_key_here
